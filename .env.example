# Environment variables required to run MONUMENT.
# Local development: copy this to backend/.env and fill in real values.
# Netlify: set these under Site settings > Environment variables (names only shown here, never commit real secrets).

# Supabase PostgreSQL connection string used by Prisma at runtime (application
# queries). Use the pooled ("Transaction" mode, port 6543) connection string
# from Supabase > Project Settings > Database > Connection string.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# Direct (non-pooled, port 5432) connection string, used by Prisma only for
# running migrations (`prisma migrate`). Required because the pooled
# connection above cannot run schema migrations.
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Secret used to sign JWT auth cookies. Must be set to a long random value
# in production (Netlify) — never reuse the local development default.
JWT_SECRET=

# Local Express dev server port. Not used on Netlify (functions runtime
# assigns its own port).
PORT=4000

# Origin of the deployed frontend, used for CORS allow-listing.
FRONTEND_URL="http://localhost:5173"

# development | production
NODE_ENV="development"
